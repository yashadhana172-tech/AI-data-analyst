# ==============================================================================
# InsightAI – AI Data Analyst Environment Configuration
# ==============================================================================

# Project
PROJECT_NAME="InsightAI – AI Data Analyst"
API_V1_STR="/api"

# Security (Generate a strong random key in production)
SECRET_KEY="insight-ai-super-secret-key-change-in-production-2025"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# SQLite (default for instant zero-dependency local running):
DATABASE_URL="sqlite:///./data/insight_ai.db"
# Or PostgreSQL for production/docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insight_ai_db"

# LLM Provider Configuration
# Set your OpenAI API key below. If left empty, InsightAI uses its built-in
# analytical heuristics engine to guarantee 100% offline functionality.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
LLM_PROVIDER="openai"

# File Upload & Data Storage
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]
